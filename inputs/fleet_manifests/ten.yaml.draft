# Charter coverage — heavily TC-skewed (~85% TC + bareboat per data kit; ~15% spot).
# UNVERIFIED (shadow) throughout: Q1 values carried; the release gives only fleet-wide
# employment DAYS (Q2 2026: fixed-rate TC 3,569 / variable-rate TC + pool 1,263 /
# spot 652 of 5,484 operating days), not a per-class mix. Re-derive at the live land
# from the rows with the Jun-5 kit deltas applied (ten_log 2026-06-11): Suezmax =
# Decathlon + Alaska + Archangel (spot-indexed) = 3 of 14 = 0.214 if Dimitris P goes
# TC (0.286 if not); Aframax: the inherited 0.143 vs the rows' 0.095 is LOAD-BEARING
# in the strip (coverage 0.857 vs 0.905) — re-derive, do not carry.
spot_coverage_pct:
  VLCC:     0.00              # 2 vessels (Dias I, Hercules I) both on TC — Q1 comment "3 vessels" predated the Ulysses removal
  Suezmax:  0.143             # Q1 value kept — 2 of 14 spot on the Q1 rows (DimitrisP, Decathlon); ArtVoy/ApoVoy on bareboat (treated TC-economic); live land: 0.214 (see above), UNVERIFIED (shadow)
  Aframax:  0.143             # Q1 value kept — the rows foot to 2 of 21 spot (MariaP, SapporoP) = 0.095; the Q1 comment's "3 of 21" named only 3 hulls of which one (AsahiP) is on TC — inherited inconsistency, LOAD-BEARING (strip coverage 0.857 vs 0.905), UNVERIFIED (shadow): re-derive employment mix at the live land
  LR2:      0.50              # Promitheas + Propontis spot; 2 DF on TC
  LR1:      0.222             # Selecao + Socrates spot; 7 on TC
  MR:       0.00              # both on TC
  Handysize: 1.00             # both Bosporos/Byzantion pool/spot
  LNGC:     0.00              # both on long-term TC

# fleet_summary — informational; sleeve totals support the 3-sleeve aggregation
fleet_summary:
  on_curve_total: 56                      # = sum of row counts (guard: tests/test_validate.py cross-foot); unchanged vs Q1
  shuttle_off_curve_count: 4              # OFF-CURVE via shuttle_contracted_book (METHODOLOGY §11.6); Anfield DP (delivered 2026-07-28) makes 5 from Q3
  newbuild_orders_q2: 19                  # at 2026-06-30: 10 shuttle (incl. Anfield DP) + 5 panamax + 3 vlcc + 1 lng; the second LNG (release row 26) undated -> not counted, UNVERIFIED (shadow)
  crude_sleeve_count: 37                  # 2 VLCC + 14 conventional Suezmax + 21 Aframax
  product_sleeve_count: 17                # 4 LR2 + 9 LR1 + 2 MR + 2 Handy
  lng_sleeve_count: 2
  avg_age_crude: 9.55                     # rows re-footed 2026-09-11: Q1 9.30 + 0.25 roll
  avg_age_product: 13.67                  # rows re-footed 2026-09-11: the Q1 rows averaged 13.42 (the Q1 summary's 12.8 did not foot to its rows) + 0.25 roll
  avg_age_lng: 7.05                       # rows re-footed 2026-09-11: Q1 6.80 + 0.25 roll
  total_in_water_at_6_30: 63              # 56 owned on-curve + 4 shuttle off-curve + 3 chartered-in (excluded); Ulysses (the 4th excluded hull at Mar-31) sold May-20-2026. Release FLEET DATA prints 64.0 at end of period but 7,702k dwt / 63.5 average — see header; no hull added on the printed count
