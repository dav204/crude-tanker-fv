# =============================================================================
# Secrets — NEVER commit. Credentials live in ~/.config/crude-tanker-fv.env
# (per scripts/ingest_rocketchat_cron.sh), not anywhere under this repo.
# =============================================================================
*.rtf
*_token*
*_credentials*
*_secret*
.env
.env.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv310/          # Python 3.12 env for shipping_harvester (3.10+); engine stays on .venv (3.9)
venv/
env/

# Generated PDFs (regenerate via scripts/build_methodology_pdf.sh)
*.pdf

# Pareto research archive — PDFs are large binaries downloaded daily by the
# launchd ingest job. `*.pdf` above already ignores them; the durable
# classification index `_manifest.json` is JSON and tracked by default.

# Joeri clipboard — ~837 PNGs from Rocket.Chat ingest; ~12-25% are FFA grids,
# rest is screenshot noise. Stay local; downstream-parsed CSVs are tracked.
inputs/ffa_drybulk/**/*.png
inputs/joeri_clipboard/**/*.png

# Pipeline snapshot state (machine-local; durable history lives in decisions/)
# Note: state/.gitignore also exists for belt-and-braces.
state/last_run.json

# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code per-machine settings — slash commands at .claude/commands/
# ARE tracked (shared institutional knowledge); settings.local.json holds
# user-specific permission allowances and stays local.
.claude/settings.local.json

# Logs / scratch
*.log
scratch/

# Rocket.Chat ingest binary archives (FFA screenshots, ~1GB+ of PNGs) —
# same convention as research_pareto*: raw research binaries stay out of
# git; only derived/parsed artifacts are committed. (2026-06-10)
inputs/ffa_drybulk/

# EDGAR filing staging (WO2 2.2) — primary docs are .htm so the blanket
# *.pdf rule does NOT cover them; the whole tree is machine-local staging
# (state/edgar_manifest.jsonl is the arrival record; promotion is human).
inputs/filings/

# Vendored harvester tool (broker-weekly parser). SOURCE is tracked (2026-06-23 —
# Test 1 actively depends on its parser code, so it must be versioned); it is NOT
# integrated into src/ and runs only on .venv310 (its own deps). Only the crawl
# CACHE is ignored — 62M of regenerable output + third-party broker PDFs.
shipping_harvester/data/
# Stray copy of shipping_harvester's requirements that landed at repo root.
# This project installs into .venv and has no tracked top-level requirements.txt;
# anchored to root so a real subdir requirements.txt could still be tracked.
/requirements.txt

# Generated Test-1 vintage trees + harvester schema exports (reproducible via
# backtest.build_vintage from the harvester marks). README stays tracked.
backtest/vintages/*/
backtest/vintages/_*.json

backtest/vintages/_*.csv
PAUSE
