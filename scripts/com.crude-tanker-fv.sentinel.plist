<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.crude-tanker-fv.sentinel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dan_personal/Projects/crude-tanker-fv/scripts/sentinel_cron.sh</string>
    </array>

    <!-- Daily 08:15 local — morning read-only surface check (triggers,
         staleness, coherence, price basis) after the 07:00 RC ingest, before
         the owner's day starts. Changes nothing; exit code carries the page. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/dan_personal/Projects/crude-tanker-fv</string>

    <key>StandardOutPath</key>
    <string>/Users/dan_personal/Projects/crude-tanker-fv/state/sentinel_cron.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/dan_personal/Projects/crude-tanker-fv/state/sentinel_cron.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
