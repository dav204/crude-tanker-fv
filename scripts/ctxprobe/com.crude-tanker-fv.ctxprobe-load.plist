<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.crude-tanker-fv.ctxprobe-load</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dan_personal/Projects/crude-tanker-fv/scripts/ctxprobe/context_probe.sh</string>
    </array>

    <!-- RunAtLoad twin (WO2 0.5): fires when launchd loads the agent — login,
         boot — so those events are distinguishable from calendar firings in
         ~/ctxprobe.log (initiator = this label). Throwaway with its twin. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/dan_personal/ctxprobe.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/dan_personal/ctxprobe.err</string>
</dict>
</plist>
