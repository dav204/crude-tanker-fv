<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.crude-tanker-fv.ctxprobe</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dan_personal/Projects/crude-tanker-fv/scripts/ctxprobe/context_probe.sh</string>
    </array>

    <!-- Hourly at :07 for the 7-day measurement window (WO2 0.5). Throwaway:
         unload + delete after the checklist closes. Lives in scripts/ctxprobe/
         (NOT scripts/) so the standing-inventory guard ignores it. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>7</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/dan_personal/ctxprobe.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/dan_personal/ctxprobe.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
