<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Every 300 seconds (five minutes); RunAtLoad catches wake/restart backlog. -->
<dict>
	<key>Label</key>
	<string>com.crude-tanker-fv.delivery-worker</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/dan_personal/Projects/crude-tanker-fv/scripts/delivery_worker.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/dan_personal/Projects/crude-tanker-fv/state/delivery_worker.err</string>
	<key>StandardOutPath</key>
	<string>/Users/dan_personal/Projects/crude-tanker-fv/state/delivery_worker.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>WorkingDirectory</key>
	<string>/Users/dan_personal/Projects/crude-tanker-fv</string>
</dict>
</plist>
